{
    "$schema":  "https://opencode.ai/config.json",
    "default_agent":  "orchestrator",
    "subagent_depth":  1,
    "agents":  {
                   "orchestrator":  {
                                        "mode":  "primary",
                                        "model":  "opencode/big-pickle",
                                        "permissions":  [
                                                            {
                                                                "action":  "subagent",
                                                                "resource":  "*",
                                                                "effect":  "allow"
                                                            }
                                                        ]
                                    },
                   "explorer":  {
                                    "mode":  "subagent",
                                    "model":  "opencode/beam-free"
                                },
                   "visual-analyst":  {
                                          "mode":  "subagent",
                                          "model":  "opencode/nemotron-3.5-super-vl-free"
                                      },
                   "researcher":  {
                                      "mode":  "subagent",
                                      "model":  "opencode/big-pickle"
                                  },
                   "developer":  {
                                     "mode":  "subagent",
                                     "model":  "opencode/flint-40b-free"
                                 },
                   "debugger":  {
                                    "mode":  "subagent",
                                    "model":  "opencode/iceman-free"
                                },
                   "tester":  {
                                  "mode":  "subagent",
                                  "model":  "opencode/nemotron-3.5-lightning-free"
                              },
                   "reviewer":  {
                                    "mode":  "subagent",
                                    "model":  "opencode/big-pickle"
                                },
                   "architect":  {
                                     "mode":  "subagent",
                                     "model":  "opencode/longcat-2.5-free"
                                 },
                   "security-auditor":  {
                                            "mode":  "subagent",
                                            "model":  "opencode/nemotron-3.5-super-vl-free"
                                        },
                   "intake":  {
                                  "mode":  "subagent",
                                  "model":  "opencode/nemotron-3.5-lightning-free"
                              }
               }
}
